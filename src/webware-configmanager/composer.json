{
    "name": "webware/webware-configmanager",
    "description": "Configuration Manager for Webware modules",
    "license": "BSD-3-Clause",
    "keywords": [
        "webware",
        "mezzio",
        "webware configuration management"
    ],
    "homepage": "https://github.com/orgs/webinertia/discussions",
    "support": {
        "issues": "https://github.com/webinertia/webware-configmanager/issues",
        "chat": "https://discord.gg/9TxQ74EPsG"
    },
    "authors": [
        {
            "name": "Joey Smith",
            "email": "jsmith@webinertia.net"
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0 || ~8.6.0",
        "brick/varexporter": "^0.4 || ^0.5 || ^0.6",
        "laminas/laminas-config-aggregator": "^1.17",
        "psr/event-dispatcher": "^1.0",
        "webimpress/safe-writer": "^2.2"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.0",
        "laminas/laminas-diactoros": "^3.4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpdoc-parser": "^1.5.1",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/php-code-coverage": "^11.0",
        "phpunit/phpunit": "^11.0",
        "roave/security-advisories": "dev-master"
    },
    "extra": {
        "laminas": {
            "config-provider": "Webware\\ConfigManager\\ConfigProvider"
        }
    },
    "autoload": {
        "psr-4": {
            "Webware\\ConfigManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebwareTest\\ConfigManager\\": "test/unit/",
            "WebwareIntegrationTest\\ConfigManager\\": "test/integration/",
            "WebwareTestResource\\ConfigManager\\": "test/resource/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "phpstan analyse",
        "test": "phpunit --colors=always test",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "upload-coverage": "coveralls -v"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        },
        "allow-plugins": {
            "laminas/laminas-component-installer": true,
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
