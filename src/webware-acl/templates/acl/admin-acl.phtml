                <div class="d-flex align-items-center justify-content-end mb-2">
                    <button class="btn btn-sm btn-outline-primary py-0 px-2"
                            data-wizard-action="add-rule"
                            data-route-name="<?= $this->escapeHtmlAttr($routeName) ?>"
                            data-methods="<?= $this->escapeHtmlAttr((string) json_encode($methods)) ?>"
                            data-privs="<?= $this->escapeHtmlAttr((string) json_encode($privs)) ?>">
                        <i class="bi bi-plus-lg me-1"></i>Add rule
                    </button>
                </div>
                <?php if (! empty($routeData['rules'])): ?>
                <?php $inheritedHeaderShown = false; ?>
                <table class="table table-sm table-borderless mb-0 ims-acl-rules-table">
                    <thead class="text-secondary small">
                        <tr>
                            <th>Type</th>
                            <th>Role</th>
                            <th>Resource</th>
                            <th>Assertions</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($routeData['rules'] as $rule): ?>
                            <?php $isInherited = ! empty($rule['inherited']); ?>
                            <?php if ($isInherited && ! $inheritedHeaderShown): ?>
                                <?php $inheritedHeaderShown = true; ?>
                                <tr class="ims-acl-rules-inherited-header">
                                    <td colspan="5" class="py-1 small text-secondary">
                                        <i class="bi bi-diagram-2 me-1"></i>Inherited from
                                        <code class="ims-badge-xs"><?= $this->escapeHtml($rule['inherited_from']) ?></code>
                                    </td>
                                </tr>
                            <?php endif; ?>
                            <tr class="<?= $isInherited ? 'ims-acl-rule-inherited' : '' ?>">
                                <td class="align-middle">
                                    <?php if ($isInherited): ?>
                                        <?php if ($rule['type'] === 'Allow'): ?>
                                            <span class="badge bg-success-subtle border border-success-subtle text-success-emphasis ims-badge-xs">allow</span>
                                        <?php else: ?>
                                            <span class="badge bg-danger-subtle border border-danger-subtle text-danger-emphasis ims-badge-xs">deny</span>
                                        <?php endif; ?>
                                    <?php else: ?>
                                        <?php
                                            $newRuleType  = $rule['type'] === 'Allow' ? 'Deny' : 'Allow';
                                            $toggleVals   = (string) json_encode(['roleId' => $rule['roleId'], 'resourceId' => $rule['resourceId'], 'type' => $newRuleType]);
                                            $toggleClass  = $rule['type'] === 'Allow'
                                                ? 'bg-success-subtle border-success-subtle text-success-emphasis'
                                                : 'bg-danger-subtle border-danger-subtle text-danger-emphasis';
                                        ?>
                                        <button type="button"
                                                class="btn py-0 px-1 badge border ims-badge-xs ims-acl-rule-type-toggle <?= $toggleClass ?>"
                                                hx-patch="<?= $this->adminUrl('acl.manager.rule.update') ?>"
                                                hx-vals="<?= $this->escapeHtmlAttr($toggleVals) ?>"
                                                hx-target="main"
                                                title="Toggle to <?= $this->escapeHtmlAttr($newRuleType) ?>">
                                            <?= $this->escapeHtml($rule['type']) ?> <i class="bi bi-arrow-left-right"></i>
                                        </button>
                                    <?php endif; ?>
                                </td>
                                <td class="align-middle small<?= $isInherited ? ' text-secondary' : '' ?>">
                                    <?= $this->escapeHtml($rule['roleId']) ?>
                                </td>
                                <td class="align-middle">
                                    <code class="ims-badge-xs"><?= $this->escapeHtml($rule['resourceId']) ?></code>
                                </td>
                                <td class="align-middle">
                                    <?php foreach ($rule['assertions'] as $assertion): ?>
                                        <span class="badge bg-info-subtle border border-info-subtle text-info-emphasis ims-badge-xs d-inline-block mb-1">
                                            <i class="bi bi-key me-1"></i><?= $this->escapeHtml($assertion) ?>
                                        </span>
                                    <?php endforeach; ?>
                                </td>
                                <td class="align-middle text-end">
                                    <?php if (! $isInherited): ?>
                                        <button class="btn btn-sm btn-outline-danger py-0 px-1"
                                                hx-get="<?= $this->escapeHtmlAttr($this->adminUrl('acl.manager.rule.delete.modal', ['roleId' => $rule['roleId'], 'resourceId' => $rule['resourceId']])) ?>"
                                                hx-target="#sharedModalDialog"
                                                hx-swap="innerHTML"
                                                hx-push-url="false"
                                                hx-on::after-request="if(event.detail.successful) bootstrap.Modal.getOrCreateInstance(document.getElementById('sharedModal')).show()">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    <?php endif; ?>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
                <?php else: ?>
                    <p class="text-secondary small mb-0">No rules defined for this route yet.</p>
                <?php endif; ?>
            </div>
        <?php endforeach; ?>
    </div>
</div>
<?php else: ?>
<div class="alert alert-secondary d-flex align-items-center gap-2" id="ims-acl-section-protected">
