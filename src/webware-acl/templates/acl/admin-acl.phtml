    <span class="small">All routes are protected.</span>
</div>
<?php endif; ?>

<!-- ── PROTECTED ROUTES ─────────────────────────────────── -->
<?php if (! empty($this->protectedRoutes)): ?>
<div class="card border-secondary overflow-hidden" id="ims-acl-section-protected">
    <div class="card-header d-flex align-items-center gap-2 py-2 bg-transparent">
        <i class="bi bi-shield-check text-success"></i>
        <span class="fw-semibold small">Protected Routes</span>
        <span class="badge bg-success ms-auto"><?= (int) $filters['protected'] ?></span>
    </div>
    <div class="card-body p-0">
        <?php foreach ($this->protectedRoutes as $routeName => $routeData): ?>
            <?php
            $methods    = $routeData['methods'];
            $privs      = $routeData['derivedPrivileges'];
            $ruleCount  = $routeData['ruleCount'];
            $roleIds    = $routeData['roles'];
            $hasAssert  = $routeData['hasAssertions'];
            ?>
            <div class="ims-acl-route-row ims-acl-route-entry"
                 data-status="protected"
                 data-route-name="<?= $this->escapeHtmlAttr($routeName) ?>">
                <span class="ims-acl-route-name"><?= $this->escapeHtml($routeName) ?></span>
                <?php foreach ($methods as $method): ?>
                    <span class="ims-acl-method-pill ims-acl-method-<?= $this->escapeHtmlAttr($method) ?>"><?= $this->escapeHtml($method) ?></span>
                <?php endforeach; ?>
                <?php foreach ($privs as $priv): ?>
                    <span class="badge bg-transparent border ims-acl-priv-<?= $this->escapeHtmlAttr($priv) ?> ims-badge-xs"><?= $this->escapeHtml($priv) ?></span>
                <?php endforeach; ?>
                <?php foreach ($roleIds as $roleId): ?>
                    <span class="badge bg-primary-subtle border border-primary-subtle text-primary-emphasis ims-badge-xs">
                        <i class="bi bi-people-fill me-1"></i><?= $this->escapeHtml($roleId) ?>
                    </span>
                <?php endforeach; ?>
                <?php if ($hasAssert): ?>
                    <span class="badge bg-info-subtle border border-info-subtle text-info-emphasis ims-badge-xs">
                        <i class="bi bi-key me-1"></i>assertion
                    </span>
                <?php endif; ?>
                <span class="ms-auto d-flex gap-1">
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2 ims-acl-rules-offcanvas-trigger"
                            data-rules-panel="ims-rules-panel-<?= $this->escapeHtmlAttr(str_replace('.', '-', $routeName)) ?>"
                            data-route-name="<?= $this->escapeHtmlAttr($routeName) ?>"
                            data-methods="<?= $this->escapeHtmlAttr((string) json_encode($methods)) ?>"
                            data-privs="<?= $this->escapeHtmlAttr((string) json_encode($privs)) ?>">
                        <i class="bi bi-list-ul me-1"></i>Rules
                        <span class="badge bg-secondary"><?= $ruleCount ?></span>
                    </button>
                </span>
            </div>
            <div class="ims-acl-rules-panel d-none"
                 id="ims-rules-panel-<?= $this->escapeHtmlAttr(str_replace('.', '-', $routeName)) ?>"
