<!-- ── UNPROTECTED ROUTES ───────────────────────────────── -->
<?php if (! empty($this->unprotectedRoutes)): ?>
<div class="card border-warning mb-3 overflow-hidden" id="ims-acl-section-unprotected">
    <div class="card-header d-flex align-items-center gap-2 py-2 bg-transparent border-warning">
        <i class="bi bi-shield-exclamation text-warning"></i>
        <span class="fw-semibold small text-warning">Unprotected Routes</span>
        <span class="badge bg-warning text-dark ms-auto"><?= (int) $filters['unprotected'] ?></span>
    </div>
    <div class="card-body p-0">
        <?php foreach ($this->unprotectedRoutes as $routeName => $methods): ?>
            <?php
            $privs = array_values(array_unique(array_map(
                static fn(string $m): string => $methodPrivMap[$m] ?? 'read',
                $methods,
            )));
            ?>
            <div class="ims-acl-route-row ims-acl-route-entry"
                 data-status="unprotected"
                 data-route-name="<?= $this->escapeHtmlAttr($routeName) ?>">
                <span class="ims-acl-route-name"><?= $this->escapeHtml($routeName) ?></span>
                <?php foreach ($methods as $method): ?>
                    <span class="ims-acl-method-pill ims-acl-method-<?= $this->escapeHtmlAttr($method) ?>"><?= $this->escapeHtml($method) ?></span>
                <?php endforeach; ?>
                <?php foreach ($privs as $priv): ?>
                    <span class="badge bg-transparent border ims-acl-priv-<?= $this->escapeHtmlAttr($priv) ?> ims-badge-xs"><?= $this->escapeHtml($priv) ?></span>
                <?php endforeach; ?>
                <span class="ms-auto">
                    <button class="btn btn-sm btn-outline-warning py-0 px-2"
                            data-wizard-action="protect"
                            data-route-name="<?= $this->escapeHtmlAttr($routeName) ?>"
                            data-methods="<?= $this->escapeHtmlAttr((string) json_encode($methods)) ?>"
                            data-privs="<?= $this->escapeHtmlAttr((string) json_encode($privs)) ?>">
                        <i class="bi bi-shield-plus me-1"></i>Protect
                    </button>
                </span>
            </div>
        <?php endforeach; ?>
    </div>
</div>
<?php else: ?>
<div class="alert alert-success d-flex align-items-center gap-2 mb-3" id="ims-acl-section-unprotected">
    <i class="bi bi-shield-check-fill text-success"></i>
    <span class="small">All routes are protected.</span>
</div>
<?php endif; ?>

<!-- ── PROTECTED ROUTES ─────────────────────────────────── -->
<?php if (! empty($this->protectedRoutes)): ?>
<div class="card border-secondary overflow-hidden" id="ims-acl-section-protected">
    <div class="card-header d-flex align-items-center gap-2 py-2 bg-transparent">
        <i class="bi bi-shield-check text-success"></i>
        <span class="fw-semibold small">Protected Routes</span>
        <span class="badge bg-success ms-auto"><?= (int) $filters['protected'] ?></span>
    </div>
    <div class="card-body p-0">
        <?php foreach ($this->protectedRoutes as $routeName => $routeData): ?>
            <?php
            $methods    = $routeData['methods'];
            $privs      = $routeData['derivedPrivileges'];
            $ruleCount  = $routeData['ruleCount'];
            $roleIds    = $routeData['roles'];
            $hasAssert  = $routeData['hasAssertions'];
            ?>
            <div class="ims-acl-route-row ims-acl-route-entry"
                 data-status="protected"
                 data-route-name="<?= $this->escapeHtmlAttr($routeName) ?>">
                <span class="ims-acl-route-name"><?= $this->escapeHtml($routeName) ?></span>
                <?php foreach ($methods as $method): ?>
                    <span class="ims-acl-method-pill ims-acl-method-<?= $this->escapeHtmlAttr($method) ?>"><?= $this->escapeHtml($method) ?></span>
                <?php endforeach; ?>
                <?php foreach ($privs as $priv): ?>
                    <span class="badge bg-transparent border ims-acl-priv-<?= $this->escapeHtmlAttr($priv) ?> ims-badge-xs"><?= $this->escapeHtml($priv) ?></span>
                <?php endforeach; ?>
                <?php foreach ($roleIds as $roleId): ?>
                    <span class="badge bg-primary-subtle border border-primary-subtle text-primary-emphasis ims-badge-xs">
                        <i class="bi bi-people-fill me-1"></i><?= $this->escapeHtml($roleId) ?>
                    </span>
                <?php endforeach; ?>
                <?php if ($hasAssert): ?>
                    <span class="badge bg-info-subtle border border-info-subtle text-info-emphasis ims-badge-xs">
                        <i class="bi bi-key me-1"></i>assertion
                    </span>
                <?php endif; ?>
                <span class="ms-auto d-flex gap-1">
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2 ims-acl-rules-toggle"
                            aria-expanded="false">
                        <i class="bi bi-list-ul me-1"></i>Rules
                        <span class="badge bg-secondary"><?= $ruleCount ?></span>
                    </button>
                </span>
            </div>
            <div class="ims-acl-rules-panel d-none">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small">Rules for <code><?= $this->escapeHtml($routeName) ?></code></span>
                    <button class="btn btn-sm btn-outline-primary py-0 px-2"
                            data-wizard-action="add-rule"
                            data-route-name="<?= $this->escapeHtmlAttr($routeName) ?>"
                            data-methods="<?= $this->escapeHtmlAttr((string) json_encode($methods)) ?>"
                            data-privs="<?= $this->escapeHtmlAttr((string) json_encode($privs)) ?>">
                        <i class="bi bi-plus-lg me-1"></i>Add rule
                    </button>
                </div>
                <?php foreach ($routeData['rules'] as $rule): ?>
                    <div class="ims-acl-rule-row">
                        <?php if ($rule['type'] === 'allow'): ?>
                            <span class="badge bg-success-subtle border border-success-subtle text-success-emphasis ims-badge-xs">allow</span>
                        <?php else: ?>
                            <span class="badge bg-danger-subtle border border-danger-subtle text-danger-emphasis ims-badge-xs">deny</span>
                        <?php endif; ?>
                        <span class="small"><?= $this->escapeHtml($rule['role_id']) ?></span>
                        <i class="bi bi-arrow-right text-secondary"></i>
                        <code class="ims-badge-xs"><?= $this->escapeHtml($rule['resource_id']) ?> / <?= $this->escapeHtml($rule['privilege_id']) ?></code>
                        <?php if (! empty($rule['assertions'])): ?>
                            <?php foreach ($rule['assertions'] as $assertion): ?>
                                <span class="badge bg-info-subtle border border-info-subtle text-info-emphasis ims-badge-xs">
                                    <i class="bi bi-key me-1"></i><?= $this->escapeHtml($assertion['assertion_fqcn'] ?? 'assertion') ?>
                                </span>
                            <?php endforeach; ?>
                        <?php endif; ?>
                        <span class="ms-auto">
                            <button class="btn btn-sm btn-outline-danger py-0 px-1"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteRuleModal"
                                    data-rule-id="<?= (int) ($rule['id'] ?? 0) ?>"
                                    data-role-id="<?= $this->escapeHtmlAttr($rule['role_id']) ?>"
                                    data-resource-id="<?= $this->escapeHtmlAttr($rule['resource_id']) ?>"
                                    data-privilege-id="<?= $this->escapeHtmlAttr($rule['privilege_id']) ?>"
                                    data-rule-type="<?= $this->escapeHtmlAttr($rule['type']) ?>">
                                <i class="bi bi-trash"></i>
                            </button>
                        </span>
                    </div>
                <?php endforeach; ?>
                <?php if (empty($routeData['rules'])): ?>
                    <p class="text-secondary small mb-0">No rules defined for this route yet.</p>
                <?php endif; ?>
            </div>
        <?php endforeach; ?>
    </div>
</div>
<?php else: ?>
