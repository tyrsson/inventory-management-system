<!-- ── UNPROTECTED ROUTES ───────────────────────────────── -->
<?php if (! empty($this->unprotectedRoutes)): ?>
<div class="card border-warning mb-3 overflow-hidden" id="ims-acl-section-unprotected">
    <div class="card-header d-flex align-items-center gap-2 py-2 bg-transparent border-warning">
        <i class="bi bi-shield-exclamation text-warning"></i>
        <span class="fw-semibold small text-warning">Unprotected Routes</span>
        <span class="badge bg-warning text-dark ms-auto"><?= (int) $filters['unprotected'] ?></span>
    </div>
    <div class="card-body p-0">
        <div class="px-3 pt-3 pb-2">
            <p class="small text-warning mb-0">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                Routes listed here are <strong>not accessible to any role</strong>. To allow access, add at least one rule &mdash; for example, <em>Guest &rarr; Allow &rarr; read</em>. Until then the ACL will deny all requests to these routes.
            </p>
        </div>
        <?php foreach ($this->unprotectedRoutes as $routeName => $methods): ?>
            <?php
            $privs = array_values(array_unique(array_map(
                static fn(string $m): string => $methodPrivMap[$m] ?? 'read',
                $methods,
            )));
            ?>
            <div class="ims-acl-route-row ims-acl-route-entry"
                 data-status="unprotected"
                 data-route-name="<?= $this->escapeHtmlAttr($routeName) ?>">
                <span class="ims-acl-route-name"><?= $this->escapeHtml($routeName) ?></span>
                <?php foreach ($methods as $method): ?>
                    <span class="ims-acl-method-pill ims-acl-method-<?= $this->escapeHtmlAttr($method) ?>"><?= $this->escapeHtml($method) ?></span>
                <?php endforeach; ?>
                <?php foreach ($privs as $priv): ?>
                    <span class="badge bg-transparent border ims-acl-priv-<?= $this->escapeHtmlAttr($priv) ?> ims-badge-xs"><?= $this->escapeHtml($priv) ?></span>
                <?php endforeach; ?>
                <span class="ms-auto">
                    <button class="btn btn-sm btn-outline-warning py-0 px-2"
                            data-wizard-action="protect"
                            data-route-name="<?= $this->escapeHtmlAttr($routeName) ?>"
                            data-methods="<?= $this->escapeHtmlAttr((string) json_encode($methods)) ?>"
                            data-privs="<?= $this->escapeHtmlAttr((string) json_encode($privs)) ?>">
                        <i class="bi bi-shield-plus me-1"></i>Protect
                    </button>
                </span>
            </div>
        <?php endforeach; ?>
    </div>
</div>
<?php else: ?>
<div class="alert alert-success d-flex align-items-center gap-2 mb-3" id="ims-acl-section-unprotected">
