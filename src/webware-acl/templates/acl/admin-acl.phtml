 */

$this->headTitle('Access Control');

// HTTP method → derived privilege name
$methodPrivMap = [
    'GET'    => 'read',
    'POST'   => 'create',
    'PUT'    => 'update',
    'PATCH'  => 'update',
    'DELETE' => 'delete',
];

$filters = $this->routeFilters ?? ['all' => 0, 'unprotected' => 0, 'protected' => 0];
?>

