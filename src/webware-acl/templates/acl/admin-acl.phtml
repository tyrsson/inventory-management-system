 * @var array<string, array{methods:string[], derivedPrivileges:string[], ruleCount:int, roles:string[], hasAssertions:bool, rules:array<int,array<string,mixed>>, resourcePk:int}> $protectedRoutes
 * @var array<int, array{id:int, roleId:string, parents:int[]}>  $roleTree
