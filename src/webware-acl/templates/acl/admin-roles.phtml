                <?php foreach ($roles as $role):
                    $parentNames = array_map(
                        static fn(\Webware\Acl\Entity\Role $p) => $p->getRoleId(),
                        $role->parentId ?? []
                    );
                    $isRoot = $role->parentId === [] || $role->parentId === null;
                ?>
                    <tr>
                        <td class="fw-semibold"><?= $this->escapeHtml($role->getRoleId()) ?></td>
                        <td class="small text-secondary">
                            <?php if ($isRoot): ?>
                                <span class="fst-italic">— root role</span>
                            <?php else: ?>
                                <?= $this->escapeHtml(implode(', ', $parentNames)) ?>
                            <?php endif; ?>
                        </td>
                        <td class="text-end">
                            <?php if ($isRoot): ?>
                                <button class="btn btn-sm btn-outline-secondary py-0 px-2" disabled title="Root role — cannot edit">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            <?php else: ?>
                                <button
                                    class="btn btn-sm btn-outline-secondary py-0 px-2"
                                    hx-get="<?= $this->escapeHtmlAttr($this->adminUrl('acl.manager.role.edit.modal', ['roleId' => $role->getRoleId()])) ?>"
                                    hx-target="#sharedModalDialog"
                                    hx-swap="innerHTML"
                                    hx-push-url="false"
                                    hx-on::after-request="if(event.detail.successful) bootstrap.Modal.getOrCreateInstance(document.getElementById('sharedModal')).show()"
                                >
                                    <i class="bi bi-pencil"></i>
                                </button>
                            <?php endif; ?>
