/**
 * ACL protect-route wizard modal.
 *
 * Rendered as a partial inside admin-acl.phtml.
 * All data already assembled by BuildAccessControlMiddleware.
 *
 * @var array<int, \Webware\Acl\Entity\Role> $roles
 * @var array<int, int[]>                    $roleChildren  parentPk → childPks[]
 * @var array<int, array{id:int, roleId:string, parents:int[]}>  $roleTree
 * @var string                               $protectUrl
 */

// Build roleId → [childRoleId, ...] map for JS propagation preview
$childrenByRoleId = [];
foreach ($this->roleTree as $pk => $node) {
    $childrenByRoleId[$node['roleId']] = [];
    foreach ($this->roleChildren[$pk] ?? [] as $childPk) {
        if (isset($this->roleTree[$childPk])) {
            $childrenByRoleId[$node['roleId']][] = $this->roleTree[$childPk]['roleId'];
        }
    }
}

// Root PKs: nodes with no parents
$rootPks = [];
foreach ($this->roleTree as $pk => $node) {
    if ($node['parents'] === []) {
        $rootPks[] = $pk;
    }
}

/**
 * Recursively render one <li> node of the role tree.
 *
 * @param int                                                    $pk
 * @param array<int, array{id:int, roleId:string, parents:int[]}> $tree
 * @param array<int, int[]>                                      $children  parentPk → childPks[]
 */
$renderRoleNode = static function (int $pk) use (&$renderRoleNode, $roleTree, $roleChildren): void {
    $node = $roleTree[$pk] ?? null;
    if ($node === null) {
        return;
    }
    $childPks = $roleChildren[$pk] ?? [];
    $hasChildren = $childPks !== [];
    echo '<li class="ims-acl-role-item' . ($hasChildren ? ' has-children' : '') . '"'
        . ' data-role-id="' . htmlspecialchars($node['roleId'], ENT_QUOTES) . '"'
        . ' data-role-pk="' . (int) $pk . '"'
        . ' tabindex="0"'
        . ' role="option" aria-selected="false">';
    echo '<span class="ims-acl-role-label">';
    echo '<i class="bi bi-person-circle me-1 text-secondary"></i>';
    echo htmlspecialchars($node['roleId'], ENT_QUOTES);
    echo '</span>';
    if ($hasChildren) {
        echo '<ul class="ims-acl-role-tree ps-3 mt-1">';
        foreach ($childPks as $childPk) {
            $renderRoleNode($childPk);
        }
        echo '</ul>';
    }
    echo '</li>';
};

$roleTree     = $this->roleTree;
$roleChildren = $this->roleChildren;
?>
