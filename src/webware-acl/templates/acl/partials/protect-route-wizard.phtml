<?php
/**
 * ACL protect-route wizard modal.
 *
 * Rendered as a partial inside admin-acl.phtml.
 * All data already assembled by BuildAccessControlMiddleware.
 *
 * @var array<int, \Webware\Acl\Entity\Role> $roles  — keyed by synthetic PK
 * @var array<int, int[]>                    $roleChildren  parentPk → childPks[]
 * @var array<int, array{id:int, roleId:string, parents:int[]}>  $roleTree
 * @var string                               $protectUrl
 */

// Build roleId → [childRoleId, ...] map for JS propagation preview
$childrenByRoleId = [];
foreach ($this->roleTree as $pk => $node) {
    $childrenByRoleId[$node['roleId']] = [];
    foreach ($this->roleChildren[$pk] ?? [] as $childPk) {
        if (isset($this->roleTree[$childPk])) {
            $childrenByRoleId[$node['roleId']][] = $this->roleTree[$childPk]['roleId'];
        }
    }
}

$roleTree     = $this->roleTree;
$roleChildren = $this->roleChildren;

// Kahn's topological sort — each node is emitted only after ALL its parents
// have been processed, guaranteeing correct order with multiple inheritance.
$inDegree = [];
$depths   = [];
foreach ($roleTree as $pk => $node) {
    $inDegree[$pk] = count($node['parents']);
    if ($node['parents'] === []) {
        $depths[$pk] = 0;
    }
}

$queue = [];
foreach ($inDegree as $pk => $deg) {
    if ($deg === 0) {
        $queue[] = $pk;
    }
}

$orderedRoles = [];
while ($queue !== []) {
    $pk   = array_shift($queue);
    $node = $roleTree[$pk];

    $parentLabels = [];
    $depth        = 0;
    foreach ($node['parents'] as $parentPk) {
        if (isset($roleTree[$parentPk])) {
            $parentLabels[] = $roleTree[$parentPk]['roleId'];
        }
        if (isset($depths[$parentPk]) && $depths[$parentPk] + 1 > $depth) {
            $depth = $depths[$parentPk] + 1;
        }
    }
    $depths[$pk] = $depth;

    $orderedRoles[] = [
        'pk'      => (int) $pk,
        'roleId'  => $node['roleId'],
        'parents' => $parentLabels,
        'depth'   => $depth,
    ];

    foreach ($roleChildren[$pk] ?? [] as $childPk) {
        $inDegree[$childPk]--;
        if ($inDegree[$childPk] === 0) {
            $queue[] = $childPk;
        }
    }
}
